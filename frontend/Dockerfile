FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend ./

ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}

ARG VITE_ENABLE_LOGIN_PREFILL=false
ENV VITE_ENABLE_LOGIN_PREFILL=${VITE_ENABLE_LOGIN_PREFILL}

ARG VITE_LOGIN_PREFILL_USERNAME=
ENV VITE_LOGIN_PREFILL_USERNAME=${VITE_LOGIN_PREFILL_USERNAME}

ARG VITE_LOGIN_PREFILL_PASSWORD=
ENV VITE_LOGIN_PREFILL_PASSWORD=${VITE_LOGIN_PREFILL_PASSWORD}

RUN npm run build

FROM nginx:1.27-alpine

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
