log_format micropos_main 'remote_addr=$remote_addr host="$host" http_host="$http_host" '
    'server_name="$server_name" request="$request" status=$status upstream_status="$upstream_status" '
    'request_length=$request_length referer="$http_referer" user_agent="$http_user_agent"';

server {
    listen 80;
    server_name ${SERVER_NAME};
    error_log /dev/stderr info;
    access_log /dev/stdout micropos_main;

    client_max_body_size 32m;
    client_header_buffer_size 16k;
    large_client_header_buffers 8 32k;
    underscores_in_headers on;
    ignore_invalid_headers off;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host ${PROXY_HOST};
        proxy_set_header X-Forwarded-Host ${PROXY_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /admin/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host ${PROXY_HOST};
        proxy_set_header X-Forwarded-Host ${PROXY_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /static/ {
        alias /var/www/static/;
        access_log off;
        expires 7d;
    }

    location /media/ {
        alias /var/www/media/;
        access_log off;
        expires 7d;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
