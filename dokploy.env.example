# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# External PostgreSQL
DATABASE_URL=postgresql://user:password@postgres-host:5432/database_name

# Internal Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Official FX sync (CBU)
FX_SYNC_BASE_CURRENCY=USD
FX_SYNC_QUOTE_CURRENCY=UZS
FX_SYNC_TIMEZONE=Asia/Tashkent
FX_SYNC_HOUR=8
FX_SYNC_MINUTE=5
FX_SYNC_OVERWRITE_MANUAL=true

# Frontend / browser
# For one-domain Dokploy path routing keep this empty.
VITE_API_URL=
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Optional runtime tuning
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
